#!/bin/sh
set -eu
node scripts/publication-guard.mjs --history
scanner=$(git config --get rin.gitleaksPath || command -v gitleaks || true)
if [ -z "$scanner" ]; then
  echo 'Install Gitleaks and add it to PATH before pushing.' >&2
  exit 1
fi
"$scanner" git . --redact --ignore-gitleaks-allow --log-opts="--all"
