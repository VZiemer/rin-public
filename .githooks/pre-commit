#!/bin/sh
set -eu
node scripts/publication-guard.mjs
scanner=$(git config --get rin.gitleaksPath || command -v gitleaks || true)
if [ -z "$scanner" ]; then
  echo 'Install Gitleaks and add it to PATH before committing.' >&2
  exit 1
fi
"$scanner" git . --pre-commit --staged --redact --ignore-gitleaks-allow
