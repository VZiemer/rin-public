APP_ENV=dev
DEV_USER_ID=dev-user
TABLE_NAME=rin-dev-data
AWS_REGION=us-east-1
MODEL_PROVIDER=static
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Optional chat override; background services continue using MODEL_PROVIDER.
# AGENT_MODEL_PROVIDER=bedrock
# AGENT_BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0
# AGENT_MODEL_PROVIDER=bedrock-openai
# BEDROCK_OPENAI_MODEL_ID=us.openai.gpt-6.1-sol
# Direct OpenAI API is also supported if you have its own credential:
# AGENT_MODEL_PROVIDER=openai
# OPENAI_MODEL_ID=gpt-6.1-sol
# OPENAI_SECRET_ARN=arn:aws:secretsmanager:us-east-1:ACCOUNT:secret:NAME
# OPENAI_API_KEY=local-development-only
ENABLE_DEBUG_ENDPOINTS=false
# FIREBASE_SECRET_ARN=arn:aws:secretsmanager:us-east-1:ACCOUNT:secret:NAME
# Optional scheduled dev pushes, requires FIREBASE_SECRET_ARN:
TEST_PUSH_ENABLED=false
TEST_PUSH_DEVICE_ID=android-test
