{
  "name": "rin-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-world.mjs && node scripts/build-assets.mjs && node scripts/build-behavior.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "seed:dev": "tsx src/bootstrap/seed-command.ts",
    "format": "prettier --write src tests scripts *.json *.mjs",
    "format:check": "prettier --check src tests scripts *.json *.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1131.0",
    "@aws-sdk/client-lambda": "^3.1131.0",
    "@aws-sdk/client-scheduler": "^3.1131.0",
    "@aws-sdk/client-sts": "^3.1131.0",
    "@aws-sdk/credential-provider-node": "^3.972.83",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "fflate": "^0.8.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1131.0",
    "@aws-sdk/client-dynamodb": "^3.1131.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/client-secrets-manager": "^3.1131.0",
    "@aws-sdk/lib-dynamodb": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@smithy/signature-v4": "^5.7.3",
    "fast-xml-parser": "^5.11.2",
    "firebase-admin": "^14.4.0",
    "image-size": "^2.0.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.4"
  },
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    }
  }
}
